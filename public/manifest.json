{
  "manifest_version": 3,
  "name": "SuperBar",
  "version": "1.0.0",
  "description": "A customizable search bar in a popup window",
  "permissions": [
    "storage",
    "bookmarks",
    "commands",
    "windows"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open SuperBar search"
    }
  },
  "action": {
    "default_title": "SuperBar"
  },
  "options_page": "settings.html"
}
